# Copiá este archivo como .env y completá los valores (en Vercel: Settings → Environment Variables)

# Google Sheets (la "base de datos")
SHEETS_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec
SHEETS_API_SECRET=la-misma-clave-que-pusiste-en-API_SECRET

# Login del panel /admin
ADMIN_EMAIL=admin@barberia.com
ADMIN_PASSWORD=una-contraseña
# Opcional: clave para firmar la cookie de sesión (si no está, se deriva del email+contraseña)
SESSION_SECRET=

# Identificador del negocio (se guarda en cada fila, como antes)
PUBLIC_NEGOCIO_ID=

# Emails de aviso de turnos
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Solo para correr scripts/migrar-supabase.mjs (después se pueden borrar)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
